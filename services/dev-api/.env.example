# Copy to services/dev-api/.env (gitignored).

# Privy dashboard -> App ID. Needed from M8.
PRIVY_APP_ID=
# Secret. Privy dashboard -> App settings -> app secret. Server only; never in apps/web.
PRIVY_APP_SECRET=
# Optional. Privy dashboard -> App settings -> verification key (skips the key fetch).
PRIVY_VERIFICATION_KEY=
# Secret. Generate locally with: openssl rand -base64 32
KYC_ENCRYPTION_KEY=

# Deadline-sprint server (read from the shell environment; `pnpm dev` sets DEV_MODE=true).
# RPC_URL=http://127.0.0.1:8545
# PORT=8787
# DEV_MODE=true            # accepts "Bearer dev:<address>"; refused together with NODE_ENV=production
# ADMIN_PRIVATE_KEY=       # defaults to Anvil account #0 only when the chain id is 31337 (or set in services/.env)
# WELCOME_GRANT_MUSDC=20000
# DEPLOYMENT_PATH=         # defaults to deployments/local.json
