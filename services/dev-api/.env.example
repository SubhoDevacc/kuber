# Copy to services/dev-api/.env (gitignored).

# Privy dashboard -> App ID. Needed from M8.
PRIVY_APP_ID=
# Secret. Privy dashboard -> App settings -> app secret. Server only; never in apps/web.
PRIVY_APP_SECRET=
# Optional. Privy dashboard -> App settings -> verification key (skips the key fetch).
PRIVY_VERIFICATION_KEY=
# Secret. Generate locally with: openssl rand -base64 32
KYC_ENCRYPTION_KEY=

# Deadline-sprint server (read from the shell environment; `pnpm dev` sets DEV_MODE=true).
# RPC_URL=http://127.0.0.1:8545
# PORT=8787
# DEV_MODE=true            # accepts "Bearer dev:<address>"; refused together with NODE_ENV=production
# ADMIN_PRIVATE_KEY=       # defaults to Anvil account #0 only when the chain id is 31337 (or set in services/.env)
# WELCOME_GRANT_MUSDC=20000
# DEPLOYMENT_PATH=         # defaults to deployments/local.json

# Real app (REAL-APP.md): `pnpm start:app`, or `pnpm start:hosted` which starts it as a child when the key is set.
# Server only; never in apps/web. Without FUJI_ADMIN_PRIVATE_KEY every /api/app route answers 503.
# FUJI_ADMIN_PRIVATE_KEY=  # the Fuji deployer (owner of registry and token, minter); pays gas, grants and practice members
# FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# FUJI_DEPLOYMENT_PATH=    # defaults to deployments/fuji.json
# SESSION_SECRET=          # >= 16 chars; generate with: openssl rand -base64 32
# PRIVY_APP_ID / PRIVY_APP_SECRET above: optional, verify privyToken (one welcome grant per Privy user)
# WELCOME_GRANT_MUSDC=20000  WELCOME_GAS_AVAX=0.05  FAUCET_MUSDC=10000  PRACTICE_GAS_AVAX=0.02
# KEEPER_INTERVAL_MS=10000   LOG_CHUNK=100   NAMES_PATH=<os tmp>/kuber-app-names.json   APP_PORT=8788
