# Copy to services/dev-api/.env (gitignored).

# Privy dashboard -> App ID. Needed from M8.
PRIVY_APP_ID=
# Secret. Privy dashboard -> App settings -> app secret. Server only; never in apps/web.
PRIVY_APP_SECRET=
# Optional. Privy dashboard -> App settings -> verification key (skips the key fetch).
PRIVY_VERIFICATION_KEY=
# Secret. Generate locally with: openssl rand -base64 32
KYC_ENCRYPTION_KEY=
