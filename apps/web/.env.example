# Every VITE_ value is bundled into the browser, so never put a secret here.
# Copy to apps/web/.env.local (gitignored).

# Privy dashboard -> App ID. Public by design; needed from M9.
VITE_PRIVY_APP_ID=
# Relative URL that the Vite dev server proxies to Anvil (SPEC §5).
VITE_RPC_URL=/rpc
# privy or dev. dev uses a local burner key and never ships in production.
VITE_AUTH_MODE=dev
# 1 = run the whole app on an in-browser copy of the server's tutorial (no chain or server needed).
# `pnpm --filter @kuber/web dev:mock` does the same.
VITE_MOCK_API=
# Where `vite` proxies /api and /rpc (dev server only, never bundled).
# Defaults: http://127.0.0.1:8787 and http://127.0.0.1:8545.
KUBER_API_TARGET=
KUBER_RPC_TARGET=
# Where `vite` proxies /api/app (the real app's server). Default http://127.0.0.1:8788.
KUBER_APP_API_TARGET=
# Real app: the RPC the browser uses for Fuji reads and dev-key sends. Default: the public Fuji RPC.
VITE_APP_RPC_URL=
# DEV ONLY, never in a production build: a private key used instead of Privy so the real app can be walked headless.
VITE_APP_DEV_KEY=
